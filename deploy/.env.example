# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 git에 올리지 않습니다)
#   cp .env.example .env && nano .env

# 서버 도메인 (DNS A 레코드가 이 서버 IP를 가리켜야 HTTPS 인증서를 받습니다)
API_DOMAIN=api.example.com

# DB 비밀번호 (아무 긴 무작위 문자열)
DB_PASSWORD=

# 로그인 토큰 서명 키 (32자 이상 무작위 문자열, 필수: 없으면 서버가 뜨지 않음)
# 만드는 법: openssl rand -base64 48
JWT_SECRET=

# 소셜 로그인
KAKAO_ADMIN_KEY=
# 웹 카카오 로그인: 카카오 콘솔 앱 키의 REST API 키. 카카오 로그인 보안에서 Client Secret을 켰다면 그 값도
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_IDS=

# 친구 초대 링크 앞부분 (웹 앱 주소)
INVITE_BASE_URL=

# 비밀번호 찾기 메일 (Gmail 앱 비밀번호)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# AI 추천 (Claude API)
ANTHROPIC_API_KEY=

# 웹 앱 주소가 기본값과 다르면 (쉼표로 여러 개)
# CORS_ALLOWED_ORIGINS=https://han-gajiman.expo.app,https://han-gajiman--*.expo.app
