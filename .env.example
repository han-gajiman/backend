# EC2 배포용 환경변수. 이 파일을 .env로 복사해서 값을 채우세요. (.env는 git에 올리지 않습니다)
#   cp .env.example .env && nano .env

# HTTPS 주소. EC2 퍼블릭 IP가 3.35.1.2면 3-35-1-2.sslip.io (점을 - 로). 비우면 HTTP(:80)만 열림
# 웹 앱(https://han-gajiman.expo.app)은 HTTPS라서, API도 HTTPS여야 브라우저가 막지 않습니다.
DOMAIN=

# DB 비밀번호 (아무 긴 문자열). 처음 띄운 뒤 바꾸면 DB에 접속이 안 되니 주의
DB_PASSWORD=
DB_USERNAME=hangajiman

# JWT 서명 키 (32바이트 이상). 생성: openssl rand -base64 32
JWT_SECRET=

# demo = 시연용 시간 이동 API 켜짐 (DEMO-01). 시연 끝나고 운영이면 prod 등으로 바꾸기
SPRING_PROFILES_ACTIVE=demo

# 웹 앱 주소 (CORS). 쉼표로 여러 개
CORS_ALLOWED_ORIGINS=https://han-gajiman.expo.app,http://localhost:*

# 친구 초대 링크 앞부분 (FRIEND-01). 보통 https://DOMAIN 과 같게. 정해지면 주석을 풀고 채우세요 (빈 값으로 두면 링크가 깨짐)
# INVITE_BASE_URL=https://3-35-1-2.sslip.io

# 소셜 로그인
KAKAO_ADMIN_KEY=
GOOGLE_CLIENT_IDS=

# 비밀번호 찾기 메일 (비우면 메일 대신 서버 로그에 인증코드 출력)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
